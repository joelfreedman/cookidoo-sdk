# Cookidoo Credentials & Configuration
# Never commit real credentials to version control.
COOKIDOO_EMAIL=your-email@example.com
COOKIDOO_PASSWORD=your-password
COOKIDOO_LOCALE=en-US
COOKIDOO_COUNTRY=US

# Optional: Path to saved session cookies/tokens JSON file (auto-generated upon browser login)
COOKIDOO_SESSION_FILE=.cookidoo_session.json
